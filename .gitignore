# Caches and temporary directories
__pycache__/
*.pyc
*.pyo
*.pyd
.pytest_cache/
.venv/
venv/

# Large dumps/logs
dump.txt
dump2.txt
dump*.txt
# Les JSON de results/ sont l'EVIDENCE que les records citent (« persistees et versionnees ») :
# 825 Ko au total, ils sont donc VERSIONNES. Le reste (logs, .npy, warm007_genomes/, ~59 Mo)
# reste ignore. `results/*` et non `results/` : git ne sait pas re-inclure un fichier dont le
# REPERTOIRE PARENT est exclu.
results/*
!results/*.json

# Artefacts de récupération (à ne jamais réintroduire à la racine)
*_full.tsx
*_recovered.*
data/*.bak_*

# Data directory: ignore DB files, states, pickes
data/*.db
data/*.db.wal
data/*.wal
data/*.pkl
# EXCEPTION : le Hall of Fame (1,2 Mo) est le STORE DU CHAMPION -- sujet de tout l'arc S2,
# d'EDR-124 et d'EDR-HOF-IO-OVERLAP. Sans lui, un clone n'a AUCUN champion et
# load_champion_genome() leve « HoF vide : evoluer d'abord » : le depot n'est pas reprenable
# sur une autre machine.
!data/hall_of_fame.pkl
data/kuzu_db/
data/kuzudb/
data/test_kuzudb/
data/agent_states/

# Frontend-specific
frontend/node_modules/
frontend/dist/
frontend/build/

# Secrets / env (F3.12) — ignorer les vrais .env, garder les .example versionnés
.env
.env.*
frontend/.env*
!.env.example
!**/.env.example

# Editor/OS settings
.DS_Store
Thumbs.db
.vscode/
.idea/

# Artefacts metaprog generes (EDR 035) — ne jamais committer/exécuter dans le repo
tests/sandbox/generated_op.py
tests/sandbox/test_generated_op.py
src/metaprog/sandbox/generated_ops.py

# Artefacts d'execution (gestionnaire de jobs, sorties de sondes) — ajoutes le 2026-07-21
runs/
.worktrees/
probe*_out.json

  if [ -n "$only_dp" ]; then
    PYTHONIOENCODING=utf-8 python tools/check_data_paths.py --only $only_dp
  else
    PYTHONIOENCODING=utf-8 python tools/check_data_paths.py
  fi || {
    echo ""
    echo "-> Passer par src/paths.py : hall_of_fame(), agent_states(), results_file(), kuzu_graph()."
    echo "   OU declarer la dette : python tools/check_data_paths.py --update-baseline"
    fail=1
  }
fi

# 13. AGI-TAXONOMY (2026-09-09) -- la porte la plus STRICTE du depot ne tirait a AUCUN moment.

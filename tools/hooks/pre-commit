# Une ligne creuse est une regle documentee (E10). Pas de baseline : le registre nait complet.
staged_roles=$(git diff --cached --name-only --diff-filter=AM | grep -E '^(docs/roadmap/ROLES\.md|tools/check_roles_registry\.py)$')

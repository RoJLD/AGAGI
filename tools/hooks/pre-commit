#!/bin/sh
# Garde-fous à cliquet du dépôt (AGAGI) — deux vérifications INDÉPENDANTES, chacune gatée sur ses
# propres fichiers stagés. Le script sort en erreur si l'une OU l'autre échoue (drapeau `fail`).
#
# Installation : cp tools/hooks/pre-commit .git/hooks/pre-commit && chmod +x .git/hooks/pre-commit
# Bypass d'urgence (déconseillé) : git commit --no-verify
fail=0

# 1. HYGIÈNE DU GRAPHE DE RECORDS — bloque tout commit qui INTRODUIT un nouvel orphelin (record sans
# porte ni arête) ou une collision d'id. Dette légataire gelée dans results/record_link_baseline.json.
# Scopé aux records stagés -> ne bloque jamais sur le travail non-committé d'une autre session.
# ⚠️ La baseline elle-meme DOIT declencher la garde : sans ca, elargir le baseline et le
# committer seul ne verifiait RIEN -- le trou par lequel un faux vert est passe (mesure le
# 2026-09-01 : baseline elargie de 19 a 42 orphelins dans l'arbre, sans commit).
staged_rec=$(git diff --cached --name-only --diff-filter=AM | grep -E '^(docs/(EDR|ADR|SDR|REF)/.*\.md|tools/record_link_baseline\.json)$')
if [ -n "$staged_rec" ]; then
  PYTHONIOENCODING=utf-8 python tools/check_record_links.py --only $(echo "$staged_rec" | grep -v record_link_baseline || true) || {
    echo ""
    echo "-> Raccorde le record à une porte (frontmatter 'gate: Gx' et/ou 'tests: [SDR-Gx]'),"
    echo "   ou fais-le adopter par une REF, ou dé-duplique l'id. Puis re-commit."
    fail=1
  }
fi

# 2. CALIBRATION DES INSTRUMENTS (P2.3) — bloque tout commit qui touche du code d'instrument (tools/ ou
# src/seed_ai/) tant qu'un NOUVEL instrument non calibré existe dans l'arbre. Dette légataire gelée dans
# tools/instrument_calibration_baseline.json. Le checker scanne l'arbre entier (pas de --only) : il ne
# fait tourner cette garde QUE quand un .py de ces répertoires est stagé, pour ne pas la déclencher sur
# des commits de docs seuls. Motivation : un instrument non calibré ne se contente pas d'échouer, il
# PRODUIT un résultat (aliasing EDR-WARM-007). Sans ce hook, le cliquet dépendait de la discipline —
# ce que la session-mère a montré insuffisant (règle documentée sans application exécutable => violée).
staged_py=$(git diff --cached --name-only --diff-filter=AM | grep -E '^(tools|src/seed_ai)/.*\.py$')
if [ -n "$staged_py" ]; then
  # ⚠️ `--only` sur les fichiers INDEXÉS : l'arbre est PARTAGÉ entre sessions parallèles, et un
  # instrument non suivi écrit par une autre session bloquait des commits sans rapport (mesuré
  # le 2026-09-01). L'état de l'arbre reste imprimé ; seul le BLOCAGE est restreint. Même
  # principe que la porte 1, qui scope déjà avec `--only`.
  PYTHONIOENCODING=utf-8 python tools/check_instrument_calibration.py --only $staged_py || {
    echo ""
    echo "-> Un NOUVEL instrument (fonction produisant un verdict/ratio/survie/taux) n'est pas calibré."
    echo "   Ajoute un cas dans tests/sandbox/test_instrument_calibration.py (déclaration CALIBRATED),"
    echo "   OU déclare la dette : python tools/check_instrument_calibration.py --update-baseline"
    fail=1
  }
fi


# 3. INTÉGRITÉ DES GARDES DU REGISTRE — toute classe d'erreur `exécutable` doit NOMMER le test qui
# prouve qu'elle sait refuser. Une garde sans contre-exemple nommé est indiscernable d'une garde
# absente (classe E1 appliquée au méta-niveau). Baseline gelée à ZÉRO : aucune dette tolérée.
staged_reg=$(git diff --cached --name-only --diff-filter=AM | grep -E '^(docs/REF/REGISTRE_ERREURS\.md|tools/(check_)?guard_negative_cases.*)$')
if [ -n "$staged_reg" ]; then
  PYTHONIOENCODING=utf-8 python tools/check_guard_negative_cases.py || {
    echo ""
    echo "-> Nomme le test discriminant dans la colonne « Garde » du registre (cf. E6),"
    echo "   OU déclare la dette : python tools/check_guard_negative_cases.py --update-baseline"
    fail=1
  }
fi

# 4. FRAÎCHEUR DU BACKLOG — liens de records morts, numéros de tâche dupliqués, chemins disparus.
# Motivation mesurée : une direction présentée comme « à faire » avait déjà été tranchée par un record,
# et l'entrée périmée a été trouvée en allant y chercher quoi faire — au pire moment possible.
staged_bl=$(git diff --cached --name-only --diff-filter=AM | grep -E '^(docs/roadmap/PRIORITES_ET_DETTES\.md|tools/backlog_freshness_baseline\.json)$')
if [ -n "$staged_bl" ]; then
  PYTHONIOENCODING=utf-8 python tools/check_backlog_freshness.py || {
    echo ""
    echo "-> Corrige la péremption, OU déclare-la en disant POURQUOI :"
    echo "   python tools/check_backlog_freshness.py --update-baseline"
    fail=1
  }
fi

# 5. FIDELITE PREREG->RECORD (M1 du brainstorm taxonomies, 2026-09-02) — le cliquet anti-DV-substituee
# (E11 occ.4, EDR-EVO-019) existait depuis le 2026-09-01 mais n'etait PAS branche ici : il ne protegeait
# que qui pensait a le lancer (P2.16 — E10 appliquee a une garde deja ecrite). Gate sur les regles
# scellees ET les records : une DV scellee doit apparaitre dans le record qui s'en reclame, et toute
# NOUVELLE regle sans grandeur backtickee (par famille base+-bis) est refusee.
staged_pr=$(git diff --cached --name-only --diff-filter=AM | grep -E '^(docs/preregistrations/.*\.json|docs/EDR/.*\.md|tools/check_preregistration_applied\.py)$')
if [ -n "$staged_pr" ]; then
  PYTHONIOENCODING=utf-8 python tools/check_preregistration_applied.py || {
    echo ""
    echo "-> Backticke les grandeurs de la regle (ou scelle un -bis markup-only), et assure-toi que le"
    echo "   record MESURE chaque grandeur scellee (ou dit POURQUOI elle est omise)."
    fail=1
  }
fi

# 6. ÉPINGLAGE DU SUBSTRAT (P2.27, 2026-09-02) — une sonde qui construit une population torch doit
# ÉPINGLER `TorchPopulationModel.BILINEAR` (attribut de CLASSE, sinon hérité de l'ambiant -> record
# ININTERPRÉTABLE a posteriori) et donner à son optimiseur le substrat COMPLET (`Adam([pop.W])` laisse
# `U/V/W_bl` GELÉS à l'init -> nul qui ne mesure que l'initialisation). Audit fondateur : 16 sondes
# sur 19 en défaut A, 11 sur 19 en défaut B — dont les DEUX qui ont gravé les arêtes du graphe.
# Dette légataire gelée dans tools/substrate_pinning_baseline.json ; seul un NOUVEAU défaut bloque.
# ⚠️ La baseline elle-même déclenche la garde : sans ça, l'élargir et la committer seule ne
# vérifierait RIEN (E4 occ.5, faux vert mesuré le 2026-09-01).
# `--only` sur les fichiers INDEXÉS : l'arbre est PARTAGÉ, une sonde d'une autre session ne doit pas
# bloquer un commit sans rapport (même principe que les portes 1 et 2).
staged_sub=$(git diff --cached --name-only --diff-filter=AM | grep -E '^((tools|src/seed_ai)/.*\.py|tools/substrate_pinning_baseline\.json)$')
if [ -n "$staged_sub" ]; then
  PYTHONIOENCODING=utf-8 python tools/check_substrate_pinning.py --only $(echo "$staged_sub" | grep -v substrate_pinning_baseline || true) || {
    echo ""
    echo "-> Épingle le substrat AVANT make_population (try/finally + _params[\"substrate\"]), et donne"
    echo "   à l'optimiseur [pop.W] + [p for p in (pop.U, pop.V, pop.W_bl) if p is not None],"
    echo "   OU déclare la dette : python tools/check_substrate_pinning.py --update-baseline"
    fail=1
  }
fi

[ "$fail" -ne 0 ] && echo "   (urgence : git commit --no-verify)"
exit $fail

#!/bin/sh
# Garde-fous à cliquet du dépôt (AGAGI) — deux vérifications INDÉPENDANTES, chacune gatée sur ses
# propres fichiers stagés. Le script sort en erreur si l'une OU l'autre échoue (drapeau `fail`).
#
# Installation : cp tools/hooks/pre-commit .git/hooks/pre-commit && chmod +x .git/hooks/pre-commit
# Bypass d'urgence (déconseillé) : git commit --no-verify
fail=0

# 1. HYGIÈNE DU GRAPHE DE RECORDS — bloque tout commit qui INTRODUIT un nouvel orphelin (record sans
# porte ni arête) ou une collision d'id. Dette légataire gelée dans results/record_link_baseline.json.
# Scopé aux records stagés -> ne bloque jamais sur le travail non-committé d'une autre session.
# ⚠️ La baseline elle-meme DOIT declencher la garde : sans ca, elargir le baseline et le
# committer seul ne verifiait RIEN -- le trou par lequel un faux vert est passe (mesure le
# 2026-09-01 : baseline elargie de 19 a 42 orphelins dans l'arbre, sans commit).
# 2026-09-24 : `docs/reviews/*.md` entre au declencheur, en AMD. La porte 1 exige `review:` de tout
# NOUVEAU record a gate:/tests: ; sans ce motif, SUPPRIMER un fichier de revue se committait proprement
# et rendait un record defectueux sans qu'aucune porte ne parle. AMD (et non AM) parce que c'est la
# SUPPRESSION qui est le cas dangereux.
staged_rec=$(git diff --cached --name-only --diff-filter=AMD | grep -E '^(docs/(EDR|ADR|SDR|REF)/.*\.md|docs/reviews/.*\.md|tools/record_link_baseline\.json)$')
if [ -n "$staged_rec" ]; then
  # E4 occ.6 (2026-09-02, revue adversariale C3) : si SEULE la baseline est stagee, la liste --only
  # est VIDE et le checker filtre tout -> le ratchet ne pouvait pas echouer sur ce commit precis
  # (le trou residuel de l'occ.5). Baseline stagee sans record -> run NON scope (arbre entier).
  # MEME PIEGE pour docs/reviews/ : un fichier de revue n'est pas un record, aucun --only ne le
  # designe ; s'il est seul stage, le run doit etre NON SCOPE, sinon la porte ne peut pas echouer.
  only_rec=$(echo "$staged_rec" | grep -v -E 'record_link_baseline|^docs/reviews/' || true)
  if [ -n "$only_rec" ]; then
    PYTHONIOENCODING=utf-8 python tools/check_record_links.py --only $only_rec
  else
    PYTHONIOENCODING=utf-8 python tools/check_record_links.py
  fi || {
    echo ""
    echo "-> Raccorde le record à une porte (frontmatter 'gate: Gx' et/ou 'tests: [SDR-Gx]'),"
    echo "   ou fais-le adopter par une REF, ou dé-duplique l'id. Puis re-commit."
    fail=1
  }
fi

# 2. CALIBRATION DES INSTRUMENTS (P2.3) — bloque tout commit qui touche du code d'instrument (tools/ ou
# src/seed_ai/) tant qu'un NOUVEL instrument non calibré existe dans l'arbre. Dette légataire gelée dans
# tools/instrument_calibration_baseline.json. Le checker scanne l'arbre entier (pas de --only) : il ne
# fait tourner cette garde QUE quand un .py de ces répertoires est stagé, pour ne pas la déclencher sur
# des commits de docs seuls. Motivation : un instrument non calibré ne se contente pas d'échouer, il
# PRODUIT un résultat (aliasing EDR-WARM-007). Sans ce hook, le cliquet dépendait de la discipline —
# ce que la session-mère a montré insuffisant (règle documentée sans application exécutable => violée).
# ⚠️ P2.62 (2026-09-15), MESURÉ et non supposé : cette porte ne se déclenchait NI sur sa propre
# baseline (`tools/instrument_calibration_baseline.json` n'est pas un .py — l'élargir et la committer
# seule ne vérifiait RIEN, classe E4 occ.5, la même faille que la porte 1 avait fermée le 2026-09-01),
# NI sur `src/` hors `src/seed_ai` (le 9e élargissement du 2026-09-09 balaye `src` ENTIER, le hook
# n'avait pas suivi : un apprenant non calibré dans `src/agents/` était committable sans que la porte
# tire). Le jour où la baseline est passée de 0 à 3 dettes gelées, les deux trous comptaient.
staged_py=$(git diff --cached --name-only --diff-filter=AM | grep -E '^((tools|src)/.*\.py|tools/instrument_calibration_baseline\.json)$')
if [ -n "$staged_py" ]; then
  # ⚠️ `--only` sur les fichiers INDEXÉS : l'arbre est PARTAGÉ entre sessions parallèles, et un
  # instrument non suivi écrit par une autre session bloquait des commits sans rapport (mesuré
  # le 2026-09-01). L'état de l'arbre reste imprimé ; seul le BLOCAGE est restreint. Même
  # principe que la porte 1, qui scope déjà avec `--only`. Baseline stagée SEULE -> run NON scopé
  # (arbre entier), sinon la liste --only serait vide et le cliquet ne pourrait pas échouer (E4 occ.6).
  only_py=$(echo "$staged_py" | grep -v instrument_calibration_baseline || true)
  if [ -n "$only_py" ]; then
    PYTHONIOENCODING=utf-8 python tools/check_instrument_calibration.py --only $only_py
  else
    PYTHONIOENCODING=utf-8 python tools/check_instrument_calibration.py
  fi || {
    echo ""
    echo "-> Un NOUVEL instrument (fonction produisant un verdict/ratio/survie/taux) n'est pas calibré."
    echo "   Ajoute un cas dans tests/sandbox/test_instrument_calibration.py (déclaration CALIBRATED),"
    echo "   OU déclare la dette : python tools/check_instrument_calibration.py --update-baseline"
    fail=1
  }
fi


# 3. INTÉGRITÉ DES GARDES DU REGISTRE — toute classe d'erreur `exécutable` doit NOMMER le test qui
# prouve qu'elle sait refuser. Une garde sans contre-exemple nommé est indiscernable d'une garde
# absente (classe E1 appliquée au méta-niveau). Baseline gelée à ZÉRO : aucune dette tolérée.
staged_reg=$(git diff --cached --name-only --diff-filter=AM | grep -E '^(docs/REF/REGISTRE_ERREURS\.md|tools/(check_)?guard_negative_cases.*)$')
if [ -n "$staged_reg" ]; then
  PYTHONIOENCODING=utf-8 python tools/check_guard_negative_cases.py || {
    echo ""
    echo "-> Nomme le test discriminant dans la colonne « Garde » du registre (cf. E6),"
    echo "   OU déclare la dette : python tools/check_guard_negative_cases.py --update-baseline"
    fail=1
  }
fi

# 4. FRAÎCHEUR DU BACKLOG — liens de records morts, numéros de tâche dupliqués, chemins disparus.
# Motivation mesurée : une direction présentée comme « à faire » avait déjà été tranchée par un record,
# et l'entrée périmée a été trouvée en allant y chercher quoi faire — au pire moment possible.
staged_bl=$(git diff --cached --name-only --diff-filter=AM | grep -E '^(docs/roadmap/PRIORITES_ET_DETTES\.md|tools/backlog_freshness_baseline\.json)$')
if [ -n "$staged_bl" ]; then
  PYTHONIOENCODING=utf-8 python tools/check_backlog_freshness.py || {
    echo ""
    echo "-> Corrige la péremption, OU déclare-la en disant POURQUOI :"
    echo "   python tools/check_backlog_freshness.py --update-baseline"
    fail=1
  }
fi

# 5. FIDELITE PREREG->RECORD (M1 du brainstorm taxonomies, 2026-09-02) — le cliquet anti-DV-substituee
# (E11 occ.4, EDR-EVO-019) existait depuis le 2026-09-01 mais n'etait PAS branche ici : il ne protegeait
# que qui pensait a le lancer (P2.16 — E10 appliquee a une garde deja ecrite). Gate sur les regles
# scellees ET les records : une DV scellee doit apparaitre dans le record qui s'en reclame, et toute
# NOUVELLE regle sans grandeur backtickee (par famille base+-bis) est refusee.
staged_pr=$(git diff --cached --name-only --diff-filter=AM | grep -E '^(docs/preregistrations/.*\.json|docs/EDR/.*\.md|tools/check_preregistration_applied\.py)$')
if [ -n "$staged_pr" ]; then
  PYTHONIOENCODING=utf-8 python tools/check_preregistration_applied.py || {
    echo ""
    echo "-> Backticke les grandeurs de la regle (ou scelle un -bis markup-only), et assure-toi que le"
    echo "   record MESURE chaque grandeur scellee (ou dit POURQUOI elle est omise)."
    fail=1
  }
fi

# 6. ÉPINGLAGE DU SUBSTRAT (P2.27, 2026-09-02) — une sonde qui construit une population torch doit
# ÉPINGLER `TorchPopulationModel.BILINEAR` (attribut de CLASSE, sinon hérité de l'ambiant -> record
# ININTERPRÉTABLE a posteriori) et donner à son optimiseur le substrat COMPLET (`Adam([pop.W])` laisse
# `U/V/W_bl` GELÉS à l'init -> nul qui ne mesure que l'initialisation). Audit fondateur : 16 sondes
# sur 19 en défaut A, 11 sur 19 en défaut B — dont les DEUX qui ont gravé les arêtes du graphe.
# Dette légataire gelée dans tools/substrate_pinning_baseline.json ; seul un NOUVEAU défaut bloque.
# ⚠️ La baseline elle-même déclenche la garde : sans ça, l'élargir et la committer seule ne
# vérifierait RIEN (E4 occ.5, faux vert mesuré le 2026-09-01).
# `--only` sur les fichiers INDEXÉS : l'arbre est PARTAGÉ, une sonde d'une autre session ne doit pas
# bloquer un commit sans rapport (même principe que les portes 1 et 2).
staged_sub=$(git diff --cached --name-only --diff-filter=AM | grep -E '^((tools|src/seed_ai)/.*\.py|tools/substrate_pinning_baseline\.json)$')
if [ -n "$staged_sub" ]; then
  PYTHONIOENCODING=utf-8 python tools/check_substrate_pinning.py --only $(echo "$staged_sub" | grep -v substrate_pinning_baseline || true) || {
    echo ""
    echo "-> Épingle le substrat AVANT make_population (try/finally + _params[\"substrate\"]), et donne"
    echo "   à l'optimiseur [pop.W] + [p for p in (pop.U, pop.V, pop.W_bl) if p is not None],"
    echo "   OU déclare la dette : python tools/check_substrate_pinning.py --update-baseline"
    fail=1
  }
fi

# 7. PREEMPTION DE MON TRAVAIL (P2.26, E10 sens B) -- AVERTISSEMENT SEUL, JAMAIS BLOQUANT.
# Signale les empreintes de CETTE SESSION dont le travail est deja porte par le commit de quelqu'un
# d'autre. Deux raisons de ne pas bloquer : la preemption n'est PAS reparable par celui qui commite
# (son travail est deja dans HEAD), et un cliquet qui bloque sur l'irreparable est un cliquet qu'on
# desactive. La reponse juste est d'ETRE AVERTI.
# Scope par SESSION ($AGAGI_SESSION_ID, sinon $CLAUDE_CODE_SESSION_ID) : un balayage global parlerait
# a qui commite de preemptions subies par d'AUTRES sessions -- du bruit adresse a la mauvaise personne.
# Sans identite, ou sans empreinte de cette session : silencieux, cout nul.
# Condition de cablage, inscrite au backlog AVANT et mesuree le 2026-09-07 : 9 empreintes, 1 seul
# signalement, et c'est le VRAI positif connu -- zero faux positif.
PYTHONIOENCODING=utf-8 python tools/check_staged_authorship.py scan >/dev/null 2>/tmp/agagi_scan.err || true
[ -s /tmp/agagi_scan.err ] && cat /tmp/agagi_scan.err
rm -f /tmp/agagi_scan.err

# 8. COMPTES PUBLIES DANS LES SYNTHESES (gap M5) -- un chiffre annonce dans la couche de LECTURE
# (CLAUDE.md, registre, backlog, README EDR, SDR) doit se RECOMPUTER. Motivation MESUREE trois fois :
# « 19 classes sur 19 » faux le jour de l'ajout d'E20 ; « 5 cliquets tous branches » alors qu'il y en
# avait 6 ; « 105 detectes / 104 calibres » quand le cliquet en comptait 143. Les ATOMES etaient
# gardes, les RESUMES -- ce qu'une session future CITE en premier -- ne l'etaient pas.
staged_syn=$(git diff --cached --name-only --diff-filter=AM | grep -E '^(CLAUDE\.md|docs/REF/REGISTRE_ERREURS\.md|docs/roadmap/PRIORITES_ET_DETTES\.md|docs/EDR/README\.md|docs/SDR/.*\.md|docs/REF/REF-DEMAND-MARKER\.md|docs/roadmap/(FIL_DIRECTEUR_AGI|SCIENCE)\.md|docs/roadmap/ROLES\.md|tools/check_synthesis_counts\.py)$')
if [ -n "$staged_syn" ]; then
  PYTHONIOENCODING=utf-8 python tools/check_synthesis_counts.py || {
    echo ""
    echo "-> Mets la PHRASE a jour (pas seulement la balise), ou retire la balise si le chiffre est"
    echo "   HISTORIQUE (un chiffre date reste vrai : le baliser le rendrait faux demain)."
    fail=1
  }
fi

# 9. SEPARATION DE LA BARRE (P2.15, 2026-09-07) -- une barre de verdict batie sur le niveau de CHANCE
# (`1/K + marge`, `chance + marge`) doit avoir ete confrontee au PLAFOND DE L'INCAPABLE. Le defaut
# fondateur : `1/K + 0.15 = 0.3167` est SOUS le plafond du substrat `plain` qu'elle declare nul -- la
# franchir n'etablit alors AUCUNE capacite, seulement que le plancher est bas. La garde
# `assert_bar_separates_the_incapable` existait depuis le 2026-09-02 et n'etait APPELEE NULLE PART :
# E10 dans sa definition meme (une regle executable non branchee est violee).
# Dette legataire gelee dans tools/bar_separation_baseline.json (audit fondateur : 8 sondes, dont les
# DEUX qui ont grave `language->perception` et `memory->perception`) ; seul un NOUVEAU defaut bloque.
# La baseline elle-meme declenche la garde (E4 occ.5) ; `--only` sur les fichiers INDEXES (arbre partage).
staged_bar=$(git diff --cached --name-only --diff-filter=AM | grep -E '^((tools|src/seed_ai)/.*\.py|tools/bar_separation_baseline\.json)$')
if [ -n "$staged_bar" ]; then
  PYTHONIOENCODING=utf-8 python tools/check_bar_separation.py --only $(echo "$staged_bar" | grep -v bar_separation_baseline || true) || {
    echo ""
    echo "-> Confronte la barre au plafond de l'INCAPABLE (jamais au niveau de chance : c'est l'erreur"
    echo "   P2.15 elle-meme) via assert_bar_separates_the_incapable(bar, plafond, provenance),"
    echo "   OU declare la dette : python tools/check_bar_separation.py --update-baseline"
    fail=1
  }
fi

# 10. RECENSEMENT DES TESTS (P2.49, 2026-09-07) -- un test qui DISPARAIT rend la suite PLUS VERTE, donc
# aucun signal habituel ne peut alerter. Defaut mesure le jour meme : une reecriture regex non ancree a
# efface QUATRE tests sans lever, faisant passer la suite de "28 passes / 15 xfail" a "32 / 7". Un test
# supprime est une garde DESARMEE en silence -- le pendant, pour la suite, de ce que les portes 1, 2 et
# 3 font pour les records, les instruments et les gardes du registre.
# Baseline gelee dans tools/test_census_baseline.json ; elle declenche la garde elle-meme (E4 occ.5).
# `--only` sur les fichiers INDEXES (arbre PARTAGE) ; le filtre inclut D, sinon une SUPPRESSION de
# fichier -- le cas le plus grave -- serait justement le seul a ne pas etre vu.
staged_tests=$(git diff --cached --name-only --diff-filter=AMD | grep -E '^(tests/.*\.py|tools/test_census_baseline\.json)$')
if [ -n "$staged_tests" ]; then
  only_tests=$(echo "$staged_tests" | grep -v test_census_baseline || true)
  if [ -n "$only_tests" ]; then
    PYTHONIOENCODING=utf-8 python tools/check_test_census.py --only $only_tests
  else
    PYTHONIOENCODING=utf-8 python tools/check_test_census.py
  fi || {
    echo ""
    echo "-> Un test a DISPARU. Si c'est voulu (fusion, renommage, decoupe), gele-le explicitement :"
    echo "   python tools/check_test_census.py --update-baseline"
    fail=1
  }
fi

# 11. FAMILLE DE CONTROLES DECLAREE (P2.40, 2026-09-07) -- un controle applique a CHAQUE replicat est
# une FAMILLE de tests ; a seuil de test unique, son taux de fausse alarme est celui de la famille.
# Mesure : le controle (i) d'EVO-011 appliquait une bande fixe a 24 cellules -> un harnais PARFAIT
# echouait 0.216 du temps, et le premier run a bien rendu INDETERMINE-HARNAIS (classe E23).
# La garde vit dans `declare_design` (elle REFUSE n>1 sans famille declaree) -- mais une garde d'appel
# ne protege que ceux qui l'appellent : 9 runners scelles sur 12 ne declaraient AUCUN design, dont
# celui qui a produit la 3e arete etablie. Ce cliquet ferme ce trou (classe E10).
# Dette legataire gelee dans tools/control_family_baseline.json ; seul un NOUVEAU runner nu bloque.
staged_cf=$(git diff --cached --name-only --diff-filter=AM | grep -E '^((tools|src/seed_ai)/.*\.py|tools/control_family_baseline\.json)$')
if [ -n "$staged_cf" ]; then
  only_cf=$(echo "$staged_cf" | grep -v control_family_baseline || true)
  if [ -n "$only_cf" ]; then
    PYTHONIOENCODING=utf-8 python tools/check_control_family.py --only $only_cf
  else
    PYTHONIOENCODING=utf-8 python tools/check_control_family.py
  fi || {
    echo ""
    echo "-> Ce runner execute une regle SCELLEE sans declarer son design, donc sans jamais dire"
    echo "   combien de cellules forment sa famille de controles. Ajouter :"
    echo "     design = declare_design(..., control_family=assert_control_family(cells=N))"
    echo "   OU declarer la dette : python tools/check_control_family.py --update-baseline"
    fail=1
  }
fi

# 12. CHEMINS DE DONNEES (2026-09-09) -- aucun NOUVEAU chemin de donnees ecrit en dur. Inventaire :
# 57 litteraux dans 26 fichiers, 16 constantes de module, et UNE SEULE variable d'environnement liee
# aux donnees. Heberger les donnees ailleurs -- un NAS, un autre disque, une autre machine --
# demandait donc d'editer 26 fichiers : le stockage etait une propriete du CODE alors que c'est une
# propriete du DEPLOIEMENT. `src/paths.py` fournit l'indirection (AGAGI_DATA_ROOT /
# AGAGI_RESULTS_ROOT / AGAGI_DB_ROOT, defauts = l'existant), ce cliquet empeche la dette de se
# reformer. Migrer un site vers src/paths.py ne declenche RIEN : c'est le but.
# Dette legataire gelee dans tools/data_paths_baseline.json ; la baseline declenche la garde.
staged_dp=$(git diff --cached --name-only --diff-filter=AM | grep -E '^((tools|src|backend|scripts)/.*\.py|tools/data_paths_baseline\.json)$')
if [ -n "$staged_dp" ]; then
  only_dp=$(echo "$staged_dp" | grep -v data_paths_baseline || true)
  if [ -n "$only_dp" ]; then
    PYTHONIOENCODING=utf-8 python tools/check_data_paths.py --only $only_dp
  else
    PYTHONIOENCODING=utf-8 python tools/check_data_paths.py
  fi || {
    echo ""
    echo "-> Passer par src/paths.py : hall_of_fame(), agent_states(), results_file(), kuzu_graph()."
    echo "   OU declarer la dette : python tools/check_data_paths.py --update-baseline"
    fail=1
  }
fi

# 13. AGI-TAXONOMY (2026-09-09) -- la porte la plus STRICTE du depot ne tirait a AUCUN moment.
# `check_agi_taxonomy.py` exige, pour toute arete declaree ETABLIE : un verdict `X_DEMANDED`
# (jamais `X_DECOY`), un `incapable_ceiling` NUMERIQUE avec sa provenance ecrite (>= 20 car.), et
# `emergence_bar > incapable_ceiling`. Ses DEUX ensembles d'exemption legataire ont ete VIDES le
# 2026-09-08 -- elle ne tolere donc plus rien. Et elle etait branchee NULLE PART : mesure du
# 2026-09-09, `grep -c check_agi_taxonomy tools/hooks/pre-commit` = 0 (controle positif :
# check_bar_separation = 2), 0 dans la CI, et `tools/agi_taxonomy_baseline.json` n'existait pas.
# Consequence : `data/agi_taxonomy/demands.json` etait editable et committable SANS controle, et la
# non-regression des 3 aretes etablies n'etait jamais executee. Meme scenario que
# `check_record_links` et `check_test_census` : une regression y serait SILENCIEUSE.
# La baseline declenche la garde elle-meme (classe E4 occ. 5 : l'elargir et la committer seule ne
# verifierait rien).
staged_tax=$(git diff --cached --name-only --diff-filter=AMD | grep -E '^(data/agi_taxonomy/.*\.json|tools/check_agi_taxonomy\.py|tools/agi_taxonomy_baseline\.json)$')
if [ -n "$staged_tax" ]; then
  PYTHONIOENCODING=utf-8 python tools/check_agi_taxonomy.py || {
    echo ""
    echo "-> Une arete de l'AGI-Taxonomy ne porte pas sa preuve COMPLETE : verdict X_DEMANDED,"
    echo "   incapable_ceiling numerique, ceiling_provenance ecrite, emergence_bar au-dessus du plafond."
    echo "   OU declare la dette : python tools/check_agi_taxonomy.py --update-baseline"
    fail=1
  }
fi

# 14. DEFAUTS FABRIQUES (2026-09-09, P2.49) -- une agregation qui rend une CONSTANTE sur une
# collection VIDE. `float(np.median(ages)) if ages else 0.0` : une cohorte vide n'est PAS une cohorte
# qui a survecu 0 tick. C'est la forme (a) des trois documentees dans CLAUDE.md (entree vide ->
# verdict de fond), et elle a deja produit des conclusions gravees (PAS DE RUNG, AUTEL MORT).
# ⚠️ Le pire cas mesure est un defaut a 1.0 sur un RATIO (g_fidelity_probe.py) : l'absence y prend
# EXACTEMENT la valeur du resultat nul -- « l'ablation n'a rien fait ».
# `None` et `float("nan")` sont ACCEPTES : ils DISENT « je ne sais pas ».
# Detection par AST (121 sites) et non par regex, qui en ratait 23 (formes multi-lignes, np.std).
# Dette legataire gelee dans tools/fabricated_defaults_baseline.json ; la baseline declenche la garde.
staged_fd=$(git diff --cached --name-only --diff-filter=AM | grep -E '^((tools|src|backend)/.*\.py|tools/fabricated_defaults_baseline\.json)$')
if [ -n "$staged_fd" ]; then
  only_fd=$(echo "$staged_fd" | grep -v fabricated_defaults_baseline || true)
  if [ -n "$only_fd" ]; then
    PYTHONIOENCODING=utf-8 python tools/check_fabricated_defaults.py --only $only_fd
  else
    PYTHONIOENCODING=utf-8 python tools/check_fabricated_defaults.py
  fi || {
    echo ""
    echo "-> Une collection VIDE n'est pas une mesure a zero. Rendre None / float('nan'), ou LEVER"
    echo "   si l'etat est impossible (cf. tools/ablation.py::run_condition, 2026-09-09)."
    echo "   OU declare la dette : python tools/check_fabricated_defaults.py --update-baseline"
    fail=1
  }
fi

# 15. LE CLIQUET DES CLIQUETS (2026-09-09) -- une porte doit prouver qu'elle sait ENCORE refuser.
# Les portes 1 a 14 verifient le depot ; rien ne verifiait qu'elles en sont toujours CAPABLES. Deux
# des trois faux verts du 2026-09-09 sont de cette forme exacte : `check_backlog_freshness` a rendu
# `exit 0` sur un backlog VIDE, et la garde d'amputation ecrite pour ca etait elle-meme INERTE (elle
# lisait le mauvais dictionnaire) -- elle a passe son propre contre-exemple. Une garde qui ne peut
# plus rien refuser est indiscernable, DEPUIS SES SORTIES, d'une garde qui n'a rien a refuser.
# `check_gate_mutation.py` casse chaque porte d'UNE ligne, en MEMOIRE (l'arbre est PARTAGE : jamais
# sur disque), et exige qu'un temoin rougisse. Mesure de livraison : 13 portes, 16 mutations, et
# QUATRE defauts reels trouves du premier coup, dont trois verdicts de porte sans aucun
# contre-exemple.
# `--pour-fichiers` : ne reveille QUE les portes dont le cliquet ou les temoins sont stages (~15 s
# pour une porte). Muter les treize a chaque commit couterait 4 min -- un cliquet qu'on desactive.
staged_gm=$(git diff --cached --name-only --diff-filter=AM | grep -E '^(tools/check_\w+\.py|tests/sandbox/test_\w+\.py|tools/check_gate_mutation\.py|tools/_mutation_plugin\.py)$')
if [ -n "$staged_gm" ]; then
  PYTHONIOENCODING=utf-8 python tools/check_gate_mutation.py --pour-fichiers $staged_gm || {
    echo ""
    echo "-> Une porte du hook ne prouve plus qu'elle sait refuser : sa mutation SURVIT, donc son"
    echo "   contre-exemple est DECORATIF (il existe, il est nomme, il ne distingue rien)."
    echo "   Ajouter le test qui rougit quand la garde est cassee -- pas retirer la mutation."
    fail=1
  }
fi

# 16. ANEANTISSEMENT D'UN FICHIER CONSERVE (2026-09-10) -- classe E22, generalisee au MECANISME.
# Le depot repondait deja a deux des trois occurrences, mais par des cliquets SPECIFIQUES A UN
# ARTEFACT : la porte 10 compte les TESTS, la porte 4 compte les entrees du BACKLOG. Le mecanisme,
# lui, est indifferent au fichier qu'il detruit -- le meme accident sur `tools/ablation.py`, sur un
# record d'EDR, sur `ci.yml` ou sur une baseline JSON n'etait couvert par RIEN.
# BLOQUE uniquement l'ANEANTISSEMENT : un fichier encore present (statut M) dont le COMPTE D'ENTITE
# tombe a ZERO alors que HEAD en portait. Aucun commit legitime ne vide un fichier qu'il garde ;
# supprimer pour de bon se fait par `git rm` (statut D, hors perimetre).
# SIGNALE, sans bloquer, toute baisse partielle -- retirer du code mort est legitime et frequent, et
# ce qui manquait n'etait pas un refus mais le CHIFFRE SOUS LES YEUX : c'est en lisant
# « 2372 deletions » dans la sortie de git que l'occurrence (2) a ete decouverte, par reflexe.
# Le compte est celui de l'ENTITE et non de la TAILLE : un decoupage par index peut retirer quatre
# tests sans changer notablement la taille (occurrence 3), et il ne leve jamais.
PYTHONIOENCODING=utf-8 python tools/check_amputation.py || {
  echo ""
  echo "-> Un fichier CONSERVE a perdu TOUT son contenu. Restaurer depuis HEAD (git checkout HEAD --"
  echo "   <chemin>), ou le supprimer POUR DE BON avec git rm si c'est l'intention."
  fail=1
}

# 17. GENOME PERSISTE A CHEVAUCHEMENT ENTREE/SORTIE (2026-09-15) -- classe E24, P2.46 (d).
# Le champion HoF declare 64 entrees + 126 sorties dans 172 noeuds : 18 de ses logits d'action SONT
# l'observation, sans traverser un poids, et aucune sonde de perception ne peut le lire correctement.
# `assert_no_io_overlap` protege les SONDES ; cette porte protege le DEPOT DE GENOMES : un lot persiste
# avec chevauchement (evolution topologique, preserve_io_blocks=False) entrerait sinon en silence.
# Cout nul (trois entiers par fichier, jamais les poids : 378 sujets en 0,5 s). Ne tourne que si des
# genomes, un Hall of Fame ou sa baseline sont stages -- la baseline stagee seule declenche (E4 occ. 5).
if git diff --cached --name-only --diff-filter=ACMR | grep -Eq "^(data/genomes/.*\.npz|data/hall_of_fame.*\.pkl|tools/io_overlap_baseline\.json)$"; then
  PYTHONIOENCODING=utf-8 python tools/check_io_overlap.py || {
    echo ""
    echo "-> Un genome persiste a des blocs entree/sortie qui se chevauchent (E24) : le regenerer avec"
    echo "   preserve_io_blocks=True, ou geler EN CONNAISSANCE : python tools/check_io_overlap.py --update-baseline"
    fail=1
  }
fi

# 21. REGISTRE DES ROLES (2026-09-16) -- spec pm-stratege-refutateur section 3.6 : toute ligne de
# docs/roadmap/ROLES.md porte ses cinq colonnes (instrument, controle positif, cout, compteurs, dissolution).
# Une ligne creuse est une regle documentee (E10). Pas de baseline : le registre nait complet.
staged_roles=$(git diff --cached --name-only --diff-filter=AM | grep -E '^(docs/roadmap/ROLES\.md|tools/check_roles_registry\.py)$')
if [ -n "$staged_roles" ]; then
  PYTHONIOENCODING=utf-8 python tools/check_roles_registry.py || {
    echo ""
    echo "-> Une ligne de ROLES.md n'a pas ses cinq colonnes : un role sans instrument, controle positif,"
    echo "   cout, compteurs ou critere de dissolution est une regle documentee, pas un role. Completer."
    fail=1
  }
fi

# 19. REGIME CITE <-> REGIME MESURE (2026-09-16, corrige en revue le 2026-09-23) -- classe E8 occ. 4 : un
# record qui cite une valeur de parametre doit la retrouver, MESUREE, dans un results/*.json SUIVI par
# git -- dans un bloc regime (a toute profondeur) ou ailleurs dans le fichier (CONCORDE_HORS_REGIME, une
# information, pas une faute). Mesure le 2026-09-23 : 74 records citent un parametre, 10 concordent (5
# CONCORDE + 5 CONCORDE_HORS_REGIME) -- 64 dans la baseline legataire, dont 8 DISCORDE (7 verifies).
# Se declenche si un record EDR, un results/*.json, la baseline OU le module lui-meme (check_regime_claims
# .py) est stage ; baseline seule -> non scope (E4 occ. 5). Le scope --only n'est utilise QUE si les
# fichiers stages sont EXCLUSIVEMENT des docs/EDR -- un results/*.json modifie (bloc regime change) peut
# invalider les affirmations d'AUTRES records que ceux stages, donc un results stage -> run NON scope.
# 2026-09-24 : AM -> AMD. Le commentaire de ce declencheur est celui de la porte 20 MOT POUR MOT, mais
# la 20 filtrait en AMD et la 19 en AM : un results/ SUPPRIME ne reveillait pas la 19, alors que c'est
# exactement le cas ou une valeur citee cesse d'etre verifiable.
staged_rc=$(git diff --cached --name-only --diff-filter=AMD | grep -E '^(docs/EDR/.*\.md|results/.*\.json|tools/regime_claims_baseline\.json|tools/check_regime_claims\.py)$')
if [ -n "$staged_rc" ]; then
  only_rc=$(echo "$staged_rc" | grep -E '^docs/EDR/' || true)
  non_edr_rc=$(echo "$staged_rc" | grep -vE '^docs/EDR/' || true)
  if [ -n "$only_rc" ] && [ -z "$non_edr_rc" ]; then
    PYTHONIOENCODING=utf-8 python tools/check_regime_claims.py --only $only_rc
  else
    PYTHONIOENCODING=utf-8 python tools/check_regime_claims.py
  fi || {
    echo ""
    echo "-> Une valeur de parametre citee est introuvable dans les results cites (regime OU ailleurs)."
    echo "   Citer le results/*.json SUIVI qui la porte, ou corriger la prose. Geler EN CONNAISSANCE :"
    echo "   python tools/check_regime_claims.py --update-baseline"
    fail=1
  }
fi

# 20. PROVENANCE DE L'EVIDENCE (2026-09-23, corrigee en revue architecte le 2026-09-23) -- classe E27 :
# mesure DEUX FOIS sur des clones/worktrees neufs, un record qui cite `results/*.json` absent du depot
# (ou present seulement sur le disque d'une session) ne peut etre rouvert par personne d'autre -- une
# conclusion dont l'evidence n'est plus rouvrable n'est pas refutable. `check_evidence_provenance.py`
# exige que tout chemin cite EXISTE sur le disque ET soit SUIVI par git (INDEX), ou soit publie par son
# hash (sha256 a cote de la citation -- une DECLARATION geleE/auditable, jamais une verification).
# QUATRE causes distinctes, jamais fondues : absent (nulle part), non_suivi (existe, git l'ignore),
# glob_vide (un motif a joker qui ne developpe vers aucun fichier), par_hash (declare, gele pour audit).
# Baseline legataire gelee PAR (record, chemin, cause) dans tools/evidence_provenance_baseline.json ;
# rang par_hash < non_suivi < absent/glob_vide -- un legataire qui REGRESSE vers une cause plus grave
# bloque, l'inverse non. Un record illisible BLOQUE et n'est jamais gelable.
# Se declenche si un record EDR, un results/*.json, la baseline, le module lui-meme, OU
# check_regime_claims.py (dont la porte 20 importe cited_results/_developper -- E4 occ. 5, point 7 de la
# revue) est stage. --only n'est utilise QUE si les fichiers stages sont EXCLUSIVEMENT des docs/EDR --
# un results/*.json modifie (apparu, disparu, deplace) peut changer la provenance d'AUTRES records que
# ceux stages, donc un results stage -> run NON scope (meme raisonnement que la porte 19).
staged_ep=$(git diff --cached --name-only --diff-filter=AMD | grep -E '^(docs/EDR/.*\.md|results/.*\.json|tools/evidence_provenance_baseline\.json|tools/check_evidence_provenance\.py|tools/check_regime_claims\.py)$')
if [ -n "$staged_ep" ]; then
  only_ep=$(echo "$staged_ep" | grep -E '^docs/EDR/' || true)
  non_edr_ep=$(echo "$staged_ep" | grep -vE '^docs/EDR/' || true)
  if [ -n "$only_ep" ] && [ -z "$non_edr_ep" ]; then
    PYTHONIOENCODING=utf-8 python tools/check_evidence_provenance.py --only $only_ep
  else
    PYTHONIOENCODING=utf-8 python tools/check_evidence_provenance.py
  fi || {
    echo ""
    echo "-> Un record cite une evidence ABSENTE ou NON SUIVIE (ou a REGRESSE) : git add le results/*.json,"
    echo "   publier son sha256 a cote de la citation, ou corriger le chemin. Un sha256 declare est GELE"
    echo "   dans la baseline et reste auditable (cause par_hash) -- ce n'est PAS une verification."
    echo "   Geler EN CONNAISSANCE : python tools/check_evidence_provenance.py --update-baseline"
    fail=1
  }
fi

# 22. GARDE E19 APPELEE (2026-09-23) -- un runner SCELLE dont la regle compare des bras SOUS GRADIENT
# (grille de lr, bras a pas distincts, clause_E19, sender_lr) doit appeler assert_verdict_invariant_to_
# optimizer, sinon son nul mesure le REGLAGE (RETAIN-COMPOSE : verdict invertit de 0,173 a 0,923 au seul
# lr). Meme perimetre que la porte 11 (tools/, src/seed_ai/, hors check_*.py et _HORS_PERIMETRE, reutilises
# de check_control_family). Un runner qui APPELLE la garde directement est couvert MEME sans regle JSON
# scellee (tools/learner_calibration.py : ses bras sont des litteraux Python, pas une regle verify()) --
# c'est le seul appelant reel du depot -- gele dans "appelants_garde" : en PERDRE un bloque, sinon la
# porte resterait verte si learner_calibration.py cessait d'appeler la garde. Un nom de regle NON RESOLU
# (argv) est rapporte, jamais devine ni compte "pas sous gradient" ; un nom resolu dont le fichier scelle
# est introuvable est REGLE ABSENTE. Une regle dont le contenu SERIALISE mentionne lr/learning_rate/E19
# HORS des cles structurees, sans qu'aucune forme reconnue ne tire, est INDETERMINEE (revue 2026-09-23 :
# trois runners vivants -- s2_credit_ablation(.py|_2.py), s2_reward_ablation.py -- sortaient "couvert" en
# silence). Baseline legataire gelee PAR (chemin, raison) dans tools/e19_sweep_baseline.json ; rang
# couvert < illisible < non_resolu < regle_absente < indetermine < nu -- un legataire qui EMPIRE bloque
# comme un nu tout neuf. Se declenche si un runner .py (tools/ ou src/seed_ai/), une regle scellee, la baseline,
# OU un des TROIS modules partages (le module lui-meme, check_control_family.py dont il importe _sources/
# _HORS_PERIMETRE, experiment_preflight.py qui DEFINIT la garde -- E4 occ. 5) est stage. --only n'est
# utilise QUE si les fichiers stages sont EXCLUSIVEMENT des runners .py ORDINAIRES (pas les trois modules
# partages, pas une regle JSON, pas la baseline) -- un changement a l'un de ces trois peut reclasser
# N'IMPORTE QUEL autre runner, donc force un run NON scope (meme raisonnement que les portes 19/20).
staged_e19=$(git diff --cached --name-only --diff-filter=AM | grep -E '^((tools|src/seed_ai)/.*\.py|docs/preregistrations/.*\.json|tools/e19_sweep_baseline\.json)$')
if [ -n "$staged_e19" ]; then
  only_e19=$(echo "$staged_e19" | grep -E '^(tools|src/seed_ai)/.*\.py$' | grep -vE '^tools/(check_e19_optimizer_sweep|check_control_family|experiment_preflight)\.py$' || true)
  hors_py_e19=$(echo "$staged_e19" | grep -vE '^(tools|src/seed_ai)/.*\.py$' || true)
  partages_e19=$(echo "$staged_e19" | grep -E '^tools/(check_e19_optimizer_sweep|check_control_family|experiment_preflight)\.py$' || true)
  if [ -n "$only_e19" ] && [ -z "$hors_py_e19" ] && [ -z "$partages_e19" ]; then
    PYTHONIOENCODING=utf-8 python tools/check_e19_optimizer_sweep.py --only $only_e19
  else
    PYTHONIOENCODING=utf-8 python tools/check_e19_optimizer_sweep.py
  fi || {
    echo ""
    echo "-> Ce runner compare des bras sous GRADIENT sans balayer le pas : son nul mesure le reglage (E19)."
    echo "   Appeler assert_verdict_invariant_to_optimizer(measure, lrs=...) ou geler : --update-baseline"
    fail=1
  }
fi

[ "$fail" -ne 0 ] && echo "   (urgence : git commit --no-verify)"
exit $fail

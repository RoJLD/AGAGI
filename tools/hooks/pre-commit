    echo "   cout, compteurs ou critere de dissolution est une regle documentee, pas un role. Completer."
    fail=1
  }
fi

# 18. PORTEE DE LA CALIBRATION (2026-09-23) -- P2.56, cliquet strict a baseline VIDE.
# Une declaration CALIBRATED dont TOUS les cas sont des gardes d'entree (« garde-seule ») ne certifie que le
# refus d'un argument degenere ; si AUCUN test n'importe-et-appelle le symbole, le corps de l'instrument n'a
# jamais rencontre une reponse connue (« muette »). Les 31 muettes legataires ont ete resorbees par injection
# le 2026-09-22 (0 monde reel) : la baseline est VIDE, toute NOUVELLE muette bloque. La porte juge l'INDEX
# (--index : CALIBRATED, tests et baseline tels qu'ils SERONT committes -- E10 occ. 17, comme la porte 4), donc
# un appelant present sur le disque seulement ne resorbe rien, et un test SUPPRIME (D) peut rendre une
# declaration muette. Ne tourne que si un test, le fichier de calibration, l'outil ou sa baseline sont stages
# -- la baseline stagee seule declenche (E4 occ. 5). Cout : ~3 s (AST sur ~300 fichiers, une lecture en batch).
if git diff --cached --name-only --diff-filter=ACMRD | grep -Eq "^(tests/.*\.py|tools/check_calibration_reach\.py|tools/calibration_reach_baseline\.json)$"; then
  PYTHONIOENCODING=utf-8 python tools/check_calibration_reach.py --index || {
    echo ""
    echo "-> Une declaration garde-seule NEUVE qu'aucun test n'importe-et-appelle (muette) : ajouter un cas"
    echo "   CORPS-ATTEINT (injection a dose connue, monde factice), ou geler EN CONNAISSANCE :"
    echo "   python tools/check_calibration_reach.py --update-baseline"
    fail=1
  }
fi

# 22. COPIE DEPLOYEE DES CROCHETS (2026-09-24) -- P2.108. `.git/hooks/` n'est pas versionne : les
# crochets de `tools/hooks/` y sont recopies A LA MAIN, et entre les deux rien ne tenait. Les deux
# sens sont des occurrences REELLES, pas des hypotheses :
#   (a) COPIE EN RETARD -- une porte ajoutee ici et committee ne s'execute chez PERSONNE tant que le
#       `cp` n'est pas refait. Le depot annonce alors N gardes et en fait tourner N-1, sans aucun
#       signal : une absence devenue affirmation de fond, la forme (a) du biais de ce depot. Ce sens
#       CRIE avec la commande exacte, il ne bloque pas -- le commit qui MET A JOUR un crochet est
#       dans cet etat par construction, et bloquer arreterait toute la flotte sur un fichier partage.
#   (b) COPIE EN AVANCE -- mesure par la session PM : un worktree a ecrit dans le crochet COMMUN une
#       porte qui n'existe dans AUCUN commit. ⚠️ `core.hooksPath` vaut ici un chemin ABSOLU vers le
#       `.git/hooks` du depot principal : TOUS les worktrees executent le MEME fichier, donc y ecrire
#       arme la flotte entiere. Du code que personne n'a relu bloquait chaque session qui committait
#       un record. Ce sens-la REFUSE, et c'est la raison d'etre de la porte.
# La reference est l'INDEX (`git show :<chemin>`), jamais le disque : l'arbre est PARTAGE et peut
# porter a cet instant l'edition en cours d'une autre session.
# ⚠️ CE QU'ELLE NE PEUT PAS VOIR : elle est lancee PAR le pre-commit deploye. Si CELUI-LA est absent,
# elle ne tourne pas du tout -- l'absence du pre-commit est indetectable de l'interieur. Celle de
# tout AUTRE crochet est parfaitement visible d'ici, et c'est elle qui compte : un `commit-msg`
# manquant rouvre le trou de la fusion (git ne lance AUCUN pre-commit sur une fusion propre).
# Cout : deux lectures de fichier ; l'historique n'est parcouru QUE s'il y a divergence.
PYTHONIOENCODING=utf-8 python tools/check_hook_deployment.py || {
  echo ""
  echo "-> La copie DEPLOYEE d'un crochet n'est pas celle que le depot a relue. Un crochet deploye"
  echo "   s'execute chez TOUTES les sessions (core.hooksPath absolu) : remettre la copie en"
  echo "   conformite, ou committer ce qui a ete ecrit dans le crochet commun pour qu'il soit relu."
  fail=1
}

# >>> AGAGI:FUSION-MARQUEUR >>>
# TÉMOIN lu par `tools/hooks/commit-msg`. Sur une fusion PROPRE, git ne lance AUCUN pre-commit
# (mesuré : 0 appel) ; commit-msg le relance. Sur une fusion CONFLICTUELLE, ce hook s'est DÉJÀ armé
# au commit manuel de résolution — le témoin le dit, et commit-msg ne double pas le travail.
#
# ⚠️ IDENTITÉ ET PÉRISSABILITÉ (2026-09-24, corrigé après revue adversariale). La première version
# posait un fichier VIDE à tout commit réussi, et c'était une garde DÉSARMABLE : mesuré,
# `GIT_EDITOR=false git commit` fait AVORTER le commit (rc=1) et le témoin SURVIT — après quoi
# n'importe quelle fusion propre le voyait et sautait TOUTES les portes, en silence. Le git-dir
# étant PARTAGÉ par une dizaine de sessions, le témoin de l'une désarmait la fusion de l'autre.
# Deux corrections, chacune gelée par un cas de `tests/sandbox/test_hook_on_merge.py` :
#   (a) le témoin n'est posé QUE si une fusion est EN COURS (MERGE_HEAD présent). Un commit
#       ordinaire — abouti ou avorté, squash compris — n'écrit plus rien du tout ;
#   (b) il PORTE l'identité de CETTE fusion : horodatage, HEAD, contenu de MERGE_HEAD, et l'ARBRE
#       DE L'INDEX (`git write-tree`). commit-msg exige que les quatre correspondent et que l'âge
#       soit <= 120 s. Un témoin étranger, périmé ou fabriqué ne décrit pas cette fusion-ci : il ne
#       peut plus la désarmer. ⚠️ La 4e ligne a été ajoutée APRÈS une deuxième revue : les trois
#       premières certifient « une fusion de B dans A », pas « CET index-ci », et la même paire est
#       atteignable deux fois de suite avec des index différents (détail au point de pose).
# ⚠️ Le PID n'est PAS une identité utilisable ici : mesuré sous Git Bash (git 2.54.0.windows.1),
# $PPID vaut 1 dans pre-commit COMME dans commit-msg (MSYS) — il n'identifie aucun `git commit`.
# Sans horloge lisible (`date +%s`), on ne pose RIEN : les portes tourneront deux fois sur une
# fusion conflictuelle, ce qui est le côté SÛR de l'erreur.
# Posé seulement en cas de SUCCÈS ; consommé par commit-msg à CHAQUE commit. Vit dans le git-dir,
# JAMAIS dans l'arbre de travail (qui est partagé).
_agagi_temoin=$(git rev-parse --git-path agagi-pre-commit-ran 2>/dev/null)
if [ -n "$_agagi_temoin" ]; then
  rm -f "$_agagi_temoin" 2>/dev/null || true
  _agagi_mh2=$(git rev-parse --git-path MERGE_HEAD 2>/dev/null)
  if [ "$fail" -eq 0 ] && [ -n "$_agagi_mh2" ] && [ -f "$_agagi_mh2" ]; then
    _agagi_now=$(date +%s 2>/dev/null)
    case "$_agagi_now" in
      ''|*[!0-9]*)
        echo "[agagi/pre-commit] pas d'horloge lisible : aucun témoin posé (les portes pourront"
        echo "   tourner deux fois sur cette fusion — c'est le côté sûr de l'erreur)." ;;
      *)
        # ⚠️ QUATRIÈME LIGNE : L'ARBRE DE L'INDEX (2026-09-24, deuxième revue adversariale). Les trois
        # premières lignes certifient « une fusion de B dans A » — elles ne disent RIEN de ce qui est
        # committé. Or la même paire (HEAD, MERGE_HEAD) est atteignable DEUX FOIS DE SUITE avec des
        # index DIFFÉRENTS, et c'est un accident ordinaire, reproduit 4 fois : une fusion refusée par
        # une porte laisse MERGE_HEAD en place ; l'auteur corrige, `git add`, `git commit` ; pre-commit
        # PASSE et pose le témoin ; puis le commit AVORTE à l'éditeur (`:cq`, éditeur introuvable,
        # Ctrl-C) — commit-msg n'a jamais tourné, donc n'a rien consommé, et un témoin VALIDE survit
        # dans le git-dir. C'est le seul des cinq scénarios testés qui laisse un résidu. `git
        # write-tree` est exactement « CET index-ci » : si l'index a bougé entre l'avortement et la
        # reprise (le cas quand on corrige quoi que ce soit), le témoin ne décrit plus ce commit et
        # les portes retirent. S'il n'a pas bougé, sauter est CORRECT — rien n'a changé.
        # Un index non écrivable (entrées non fusionnées) ne pose RIEN : côté sûr, les portes tirent.
        _agagi_tree=$(git write-tree 2>/dev/null)
        case "$_agagi_tree" in
          ''|*[!0-9a-fA-F]*)
            echo "[agagi/pre-commit] index non écrivable (entrées non fusionnées ?) : aucun témoin"
            echo "   posé — les portes pourront tourner deux fois sur cette fusion." ;;
          *)
            printf '%s\n%s\n%s\n%s\n' \
              "$_agagi_now" \
              "$(git rev-parse HEAD 2>/dev/null)" \
              "$(tr '\n' ' ' < "$_agagi_mh2" 2>/dev/null)" \
              "$_agagi_tree" \
              > "$_agagi_temoin" 2>/dev/null || true ;;
        esac ;;
    esac
  fi
fi
# <<< AGAGI:FUSION-MARQUEUR <<<

[ "$fail" -ne 0 ] && echo "   (urgence : git commit --no-verify)"
exit $fail

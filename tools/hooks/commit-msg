#!/bin/sh
# Crochet de FUSION (AGAGI) — arme les portes du pre-commit au moment exact où le code d'une AUTRE
# branche entre dans la sienne. Installation : cp tools/hooks/commit-msg .git/hooks/commit-msg &&
# chmod +x .git/hooks/commit-msg  (chaque clone / chaque session doit reposer la copie à la main :
# `.git/hooks/` n'est pas versionné, exactement comme pour le pre-commit).
#
# ⚠️ COMPARER LES COPIES EN NORMALISANT LES FINS DE LIGNE. Mesuré le 2026-09-24 : sur cette machine
# `core.autocrlf=true`, donc `.git/hooks/pre-commit` et `tools/hooks/pre-commit` sont en CRLF sur le
# disque alors que le blob de HEAD est en LF. Un `diff` brut entre la copie déployée et le blob rend
# 46 lignes de différence ; après `tr -d '\r'` des deux côtés, le hook déployé est EXACTEMENT la
# version de HEAD. Toute garde qui comparerait ces fichiers sans normaliser crierait au loup en
# permanence sous Windows.
#
# LE TROU, MESURÉ (2026-09-24, dépôt JETABLE, git 2.54.0.windows.1) — sur une fusion PROPRE :
#     pre-commit           0 appel      (1 sur un commit ordinaire : la sonde marche)
#     commit-msg           1 appel, MERGE_HEAD PRÉSENT, et un code 1 ANNULE la fusion
#     post-merge           appelé, mais son code de retour est IGNORÉ — il ne peut rien refuser
# Les portes du dépôt ne tiraient donc JAMAIS sur l'union de deux branches. Le cas est vivant : deux
# sessions corrigent le même compte publié en comptant des objets différents ; chaque branche est
# localement juste, l'union est fausse, et aucun conflit git ne le signale.
#
# ⚠️ DEUXIÈME MESURE, et c'est elle qui décide la forme (même dépôt jetable, même jour) : relancer
# le pre-commit TEL QUEL sur une fusion ne suffit PAS. Ses 17 appels à `git diff --cached
# --name-only` comparent l'index au PREMIER PARENT — donc au seul côté ENTRANT :
#     diff_vs_HEAD = [docs/preregistrations/b.json]
#     diff_vs_BASE = [CLAUDE.md  docs/preregistrations/a.json  docs/preregistrations/b.json]
# Quand les deux branches portent la MÊME valeur de balise (le cas qui ne conflicte pas, donc le
# cas dangereux), le document PORTEUR DU COMPTE est identique à HEAD : il n'apparaît pas dans le
# diff, et la porte 8 ne s'arme pas — un crochet naïf aurait laissé passer son propre
# contre-exemple. La comparaison à la BASE DE FUSION est posée dans `tools/hooks/pre-commit`
# (bloc AGAGI:FUSION-SCOPE), qui la fait AUSSI pour une fusion conflictuelle et pour un SQUASH, où
# il s'arme seul. Le chiffre 17 est RECOMPUTABLE (il valait « 18 » ici la veille, et c'était faux —
# le grep comptait aussi les commentaires qui citent la commande) :
#     grep -c '^[^#]*git diff --cached --name-only' tools/hooks/pre-commit
#
# ⚠️ CE QUE CE CROCHET NE COUVRE PAS, et pourquoi il n'a pas à le couvrir : `git merge --squash`.
# Mesuré — un squash ne pose AUCUN MERGE_HEAD (git écrit SQUASH_MSG), donc rien ici ne s'arme ; mais
# le commit qui le conclut est un commit ORDINAIRE, et git lance pre-commit lui-même (1 appel
# mesuré). Le squash est donc traité entièrement côté pre-commit, par l'élargissement de PORTÉE
# (bloc AGAGI:FUSION-SCOPE, qui lit la tête du côté entrant dans SQUASH_MSG). Reste une limite
# assumée et écrite : si SQUASH_MSG a été réécrit sans ses lignes « commit <sha> », la base est
# incalculable — le pre-commit le DIT à voix haute et la portée reste le premier parent.
#
# PRINCIPES : ne JAMAIS doubler le travail (un commit ordinaire sort en quelques millisecondes) ;
# ne JAMAIS recopier la logique du pre-commit (une copie divergerait en silence) ; et sortir 0 sur
# tout ce qu'on ne sait pas juger — un crochet qui plante bloquerait toute la flotte.
#
# Bypass d'urgence (déconseillé) : git commit --no-verify / git merge --no-verify

# 0. Sans git-dir, on ne sait rien juger : laisser passer.
gitdir=$(git rev-parse --git-dir 2>/dev/null) || exit 0
[ -n "$gitdir" ] || exit 0

# 1. LE TÉMOIN, ET SON IDENTITÉ. `tools/hooks/pre-commit` le pose (bloc AGAGI:FUSION-MARQUEUR)
# UNIQUEMENT quand une fusion est en cours et que toutes les portes ont passé. Il porte quatre
# lignes : horodatage epoch, HEAD, contenu de MERGE_HEAD, arbre de l'index (`git write-tree`).
#
# ⚠️ POURQUOI UNE IDENTITÉ (mesure du 2026-09-24, revue adversariale). La première version posait un
# fichier VIDE à tout commit réussi et se contentait de sa PRÉSENCE. Or `GIT_EDITOR=false git commit`
# fait AVORTER le commit (rc=1) et le témoin SURVIVAIT : ensuite n'importe quelle fusion propre le
# voyait et sautait TOUTES les portes, EN SILENCE. Et le git-dir est partagé par une dizaine de
# sessions, donc le témoin de l'une désarmait la fusion de l'autre. C'était une garde qu'on peut
# désarmer sans le savoir. Désormais un témoin ne vaut que s'il décrit CETTE fusion-ci :
#     - même HEAD et même MERGE_HEAD que maintenant ;
#     - même ARBRE D'INDEX que maintenant (`git write-tree`) ;
#     - âge <= 120 s (un témoin oublié périme tout seul) ;
#     - et il est CONSOMMÉ ici à chaque commit, quel qu'il soit.
#
# ⚠️ POURQUOI L'ARBRE, ET PAS SEULEMENT LA PAIRE (2026-09-24, DEUXIÈME revue adversariale — la
# première correction ne suffisait pas et le témoin restait désarmable par accident ORDINAIRE,
# reproduit 4 fois). (HEAD, MERGE_HEAD, horodatage) certifie « une fusion de B dans A » ; ça ne dit
# RIEN de ce qui est committé. Séquence mesurée, sans aucune malveillance : une fusion est REFUSÉE
# par une porte (MERGE_HEAD reste en place) ; l'auteur corrige, `git add`, `git commit` ; pre-commit
# PASSE et pose le témoin ; le commit AVORTE à l'éditeur (`:cq`, éditeur introuvable, Ctrl-C) — donc
# commit-msg n'a jamais tourné et n'a rien consommé. Un témoin VALIDE survit dans le git-dir : c'est
# le SEUL des cinq scénarios testés qui laisse un résidu. La tentative suivante, avec un index
# DIFFÉRENT, retrouvait la même paire et sautait toutes les portes. L'arbre de l'index est
# exactement « CET index-ci » : s'il a bougé, le témoin ne décrit plus ce commit ; s'il n'a pas
# bougé, sauter est correct puisque rien n'a changé.
# Tout ce qui ne se lit pas comme ça est traité comme ABSENT — c'est-à-dire : les portes tirent.
# ⚠️ Le PID ne peut pas servir d'identité : mesuré, $PPID vaut 1 dans pre-commit COMME dans
# commit-msg sous Git Bash (MSYS) — il n'identifie aucun `git commit` particulier.
temoin="$gitdir/agagi-pre-commit-ran"
deja=0
if [ -f "$temoin" ]; then
  t_pose=$(sed -n 1p "$temoin" 2>/dev/null)
  t_head=$(sed -n 2p "$temoin" 2>/dev/null)
  t_mh=$(sed -n 3p "$temoin" 2>/dev/null)
  t_tree=$(sed -n 4p "$temoin" 2>/dev/null)
  maintenant=$(date +%s 2>/dev/null)
  cur_head=$(git rev-parse HEAD 2>/dev/null)
  # `git write-tree` ECRIT dans la base d'objets (ce que `git commit` fait de toute facon une ligne
  # plus loin) et REFUSE un index a entrees non fusionnees -- il rend alors du vide, le temoin est
  # traite comme ABSENT, et les portes tirent. Un temoin d'ANCIEN format (3 lignes) a t_tree vide :
  # il ne peut pas correspondre, donc il ne desarme rien. Cote sur de l'erreur dans les deux cas.
  cur_tree=$(git write-tree 2>/dev/null)
  cur_mh=""
  if [ -f "$gitdir/MERGE_HEAD" ]; then
    cur_mh=$(tr '\n' ' ' < "$gitdir/MERGE_HEAD" 2>/dev/null)
  fi
  # Les deux horodatages doivent etre des entiers NON VIDES ; sinon le temoin est traite comme
  # ABSENT (cote sur de l'erreur : les portes tirent).
  nombres=0
  case "$t_pose" in
    ''|*[!0-9]*) : ;;
    *) case "$maintenant" in
         ''|*[!0-9]*) : ;;
         *) nombres=1 ;;
       esac ;;
  esac
  if [ "$nombres" -eq 1 ]; then
    age=$((maintenant - t_pose))
    if [ "$age" -ge 0 ] && [ "$age" -le 120 ] \
       && [ -n "$cur_head" ] && [ "$t_head" = "$cur_head" ] \
       && [ -n "$cur_mh" ] && [ "$t_mh" = "$cur_mh" ] \
       && [ -n "$cur_tree" ] && [ "$t_tree" = "$cur_tree" ]; then
      deja=1
    fi
  fi
fi
rm -f "$temoin" 2>/dev/null

# 2. Commit ORDINAIRE (squash compris) : pre-commit a déjà tourné, il n'y a rien à armer.
if [ ! -f "$gitdir/MERGE_HEAD" ]; then
  exit 0
fi

# 3. Fusion CONFLICTUELLE : le commit manuel de résolution a armé pre-commit (témoin posé POUR cette
# fusion), qui a lui-même élargi sa portée à la base de fusion. Relancer les portes les ferait
# tourner DEUX fois.
if [ "$deja" -eq 1 ]; then
  exit 0
fi

# 4. Fusion PROPRE : git n'a lancé AUCUN pre-commit. C'est le seul cas où ce crochet travaille.
# Le hook ACTIF est celui d'à côté ($0) — c'est la seule façon de respecter `core.hooksPath`, que ce
# dépôt fixe à un chemin ABSOLU (mesuré : $0 vaut alors ce chemin absolu, et sh sait le lire même
# écrit à la Windows). Les deux autres candidats ne servent que de filet.
pre=""
for d in "$(dirname "$0")" "$(git config --get core.hooksPath 2>/dev/null)" "$gitdir/hooks"; do
  [ -n "$d" ] || continue
  if [ -f "$d/pre-commit" ]; then pre="$d/pre-commit"; break; fi
done

if [ -z "$pre" ]; then
  echo "[agagi/commit-msg] FUSION : aucun pre-commit installé (ni à côté de ce crochet, ni dans"
  echo "   core.hooksPath, ni dans $gitdir/hooks) — les portes ne sont PAS armées sur cette fusion."
  echo "   Poser le hook : cp tools/hooks/pre-commit \"$gitdir/hooks/pre-commit\" && chmod +x ..."
  exit 0
fi
# ⚠️ CE QUE `test -x` MESURE ICI, et ce n'est pas ce qu'on croit. Mesuré le 2026-09-24 sur cette
# machine (Git Bash / Windows, git 2.54.0.windows.1) : le bit de mode est IGNORÉ — `chmod -x` est un
# no-op, et un fichier à 644 PORTANT UN SHEBANG est vu EXÉCUTABLE. Ce qui décide, c'est le shebang
# (ou l'extension) : un fichier SANS shebang est vu non exécutable, même à 755. La branche reste donc
# atteignable ici — par un pre-commit tronqué de son shebang, exactement le cas où git ne le
# lancerait pas non plus — et elle sert de filet sur les plates-formes où le bit de mode décide
# vraiment. `tests/sandbox/test_hook_on_merge.py` MESURE `test -x` avant d'exiger quoi que ce soit,
# plutôt que de supposer l'une ou l'autre plate-forme.
if [ ! -x "$pre" ]; then
  echo "[agagi/commit-msg] FUSION : $pre n'est pas exécutable — git ne l'aurait pas lancé non plus."
  echo "   (sous Git Bash, c'est le SHEBANG qui décide, pas le bit de mode : vérifier la 1re ligne.)"
  echo "   Les portes ne sont PAS armées sur cette fusion. Corriger : chmod +x \"$pre\""
  exit 0
fi

echo "[agagi/commit-msg] FUSION PROPRE : git n'arme aucun pre-commit ici — portes relancées sur"
echo "   l'UNION des deux branches (portée = base de fusion, pas le premier parent)."
if sh "$pre"; then
  rm -f "$temoin" 2>/dev/null
  exit 0
fi

# Le pre-commit relancé a reposé un témoin s'il avait réussi ; il a échoué, on nettoie par principe.
rm -f "$temoin" 2>/dev/null
echo ""
echo "-> Une porte refuse l'UNION des deux branches, alors que CHAQUE côté était juste isolément."
echo "   La fusion est annulée (rien n'est committé). Corriger dans l'arbre de fusion puis"
echo "   'git commit' pour la conclure, ou 'git merge --abort' pour revenir en arrière."
exit 1
